    <link rel="stylesheet" crossorigin="" href="/assets/index.CjbDqFej.css" integrity="sha384-CNUzca/JWzyMpdFO14C701VVyIUTLioLOMb/ppDI5cuq2p+u1FBujBlXq4hus7yb">
  </head>
  <body>
    <div id="root"></div>
    <!-- Pre-React stale-HTML recovery: if the browser loaded a cached
         index.html whose entry script no longer exists on the server
         (new deploy produced different hashed filenames), hard-reload
         to get fresh HTML before React even tries to boot. -->
    <script>
      (function() {
        if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;
        var key = '__v_reload';
        var last = sessionStorage.getItem(key);
        if (last && Date.now() - Number(last) < 30000) return;
        var entry = document.querySelector('script[src*="/assets/index."]');
        if (!entry) return;
        fetch(entry.src, { method: 'HEAD', cache: 'no-store' })
          .then(function(r) {
            if (r.status === 404) {
              sessionStorage.setItem(key, String(Date.now()));
              location.reload();
            }
          })
          .catch(function() {});
      })();
    </script>
  

</body></html>